{
  "compilerOptions": {
    "target": "ES2021",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
   "moduleResolution": "nodenext",
"module": "nodenext",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
